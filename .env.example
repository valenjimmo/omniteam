NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for OmniSite private media, verified domain state changes, and trusted admin cleanup.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public app origin used for production authentication emails.
NEXT_PUBLIC_SITE_URL=https://omniteam-seven.vercel.app

# OmniSite hosting: lowercase ASCII hostnames, no schemes, ports, or trailing dots.
# Exact platform app host allowlist, including each production/preview deployment host.
OMNISITE_APP_HOSTS=omniteam-seven.vercel.app
# Leave empty until the platform's hosting domain has been selected.
OMNISITE_ROOT_DOMAIN=
# Enable only after wildcard hosting attachment, DNS, and TLS are confirmed.
OMNISITE_MANAGED_DOMAINS_READY=false
# Server-only manual provider attestation: comma-separated custom hosts whose
# attachment + routing + TLS have been verified by the platform operator.
OMNISITE_PROVIDER_READY_HOSTS=
# Enable HSTS only after all served hostnames support production HTTPS.
OMNISITE_HTTPS_READY=false

# Scheduled production operations and smoke checks. Configure these as GitHub
# secrets/variables; never expose the service-role key to browser code.
SUPABASE_URL=
CRON_SECRET=
PRODUCTION_SMOKE_URL=https://omniteam-seven.vercel.app
PRODUCTION_SMOKE_SITE_SLUG=
